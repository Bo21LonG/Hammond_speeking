 .practice-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.top-bar,
.stage-box,
.chat-stream,
.input-box {
  border-radius: 32rpx;
}

.top-bar {
  padding: 28rpx;
}

.top-line {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.practice-title {
  margin-top: 16rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.end-link {
  align-self: flex-start;
  padding: 18rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.04);
  color: rgba(236, 242, 255, 0.72);
  font-size: 22rpx;
}

.stage-pill {
  margin-top: 24rpx;
  color: rgba(226, 233, 250, 0.65);
  font-size: 24rpx;
}

.energy-track {
  position: relative;
  height: 18rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.energy-fill {
  height: 100%;
  border-radius: inherit;
  transition: width 240ms ease;
}

.energy-fill--green {
  background: linear-gradient(90deg, #5effbc, #2fcf7f);
}

.energy-fill--yellow {
  background: linear-gradient(90deg, #ffd66b, #ffaf45);
}

.energy-fill--red {
  background: linear-gradient(90deg, #ff7f8f, #ff4747);
}

.energy-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  color: rgba(230, 236, 250, 0.72);
  font-size: 22rpx;
}

.stage-box {
  padding: 28rpx;
}

.stage-caption {
  color: rgba(160, 188, 255, 0.78);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.stage-name {
  margin-top: 14rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.stage-goal,
.stage-hint {
  margin-top: 16rpx;
  color: rgba(232, 239, 253, 0.78);
  font-size: 25rpx;
  line-height: 1.7;
}

.chat-stream {
  height: 700rpx;
  padding: 24rpx;
}

.chat-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.bubble-row {
  display: flex;
}

.bubble-row--ai {
  justify-content: flex-start;
}

.bubble-row--user {
  justify-content: flex-end;
}

.bubble {
  max-width: 86%;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
}

.bubble--ai {
  background: rgba(255, 255, 255, 0.05);
}

.bubble--user {
  background: linear-gradient(135deg, rgba(75, 119, 255, 0.92), rgba(121, 87, 255, 0.88));
}

.bubble-role {
  color: rgba(223, 231, 249, 0.62);
  font-size: 20rpx;
}

.bubble-text {
  margin-top: 10rpx;
  color: #f9fbff;
  font-size: 27rpx;
  line-height: 1.7;
}

.feedback-toast {
  padding: 18rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(250, 189, 80, 0.12);
  border: 1rpx solid rgba(250, 189, 80, 0.22);
  color: #ffd98a;
  font-size: 24rpx;
  line-height: 1.65;
}

.input-box {
  padding: 28rpx;
}

.input-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.input-title {
  font-size: 28rpx;
  font-weight: 700;
}

.input-note {
  max-width: 320rpx;
  color: rgba(226, 233, 248, 0.54);
  font-size: 21rpx;
  line-height: 1.5;
  text-align: right;
}

.practice-textarea {
  width: 100%;
  min-height: 180rpx;
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.04);
  color: #f7f9ff;
  font-size: 28rpx;
  line-height: 1.6;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.quick-chip {
  padding: 18rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
  color: rgba(236, 241, 254, 0.82);
  font-size: 22rpx;
  line-height: 1.4;
}

.input-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.simulate-button,
.submit-button {
  flex: 1;
}

.transition-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(3, 7, 16, 0.5);
}

.transition-card {
  width: 400rpx;
  padding: 32rpx 24rpx;
  border-radius: 34rpx;
  text-align: center;
}

.transition-kicker {
  color: #9ebcff;
  font-size: 24rpx;
  letter-spacing: 3rpx;
}

.transition-stage {
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 700;
}
