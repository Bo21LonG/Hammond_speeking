 .report-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.report-hero,
.completion-box,
.report-block {
  border-radius: 34rpx;
}

.report-hero {
  padding: 34rpx 30rpx;
}

.report-title {
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.report-copy {
  margin-top: 16rpx;
  color: rgba(231, 238, 253, 0.74);
  font-size: 25rpx;
  line-height: 1.7;
}

.score-ring {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  height: 220rpx;
  margin: 34rpx auto 0;
  border-radius: 50%;
  border: 12rpx solid rgba(108, 156, 255, 0.18);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.06);
}

.score-value {
  font-size: 72rpx;
  font-weight: 700;
}

.score-label {
  margin-top: 8rpx;
  color: rgba(227, 235, 252, 0.58);
  font-size: 23rpx;
}

.score-grid {
  display: flex;
  gap: 16rpx;
}

.score-card {
  flex: 1;
  padding: 24rpx 12rpx;
  border-radius: 30rpx;
  text-align: center;
}

.score-card-value {
  font-size: 46rpx;
  font-weight: 700;
}

.score-card-label {
  margin-top: 12rpx;
  color: rgba(226, 233, 248, 0.62);
  font-size: 22rpx;
}

.completion-box {
  padding: 28rpx;
}

.completion-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.completion-title {
  font-size: 28rpx;
  font-weight: 700;
}

.completion-score {
  color: #9cbcff;
  font-size: 28rpx;
  font-weight: 700;
}

.report-block {
  padding: 28rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 700;
}

.correction-item {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.correction-label {
  color: rgba(158, 188, 255, 0.78);
  font-size: 21rpx;
  letter-spacing: 2rpx;
}

.correction-text {
  margin-top: 12rpx;
  color: #f6f9ff;
  font-size: 27rpx;
  line-height: 1.65;
}

.correction-text--muted {
  color: rgba(232, 238, 253, 0.68);
}

.correction-reason {
  margin-top: 10rpx;
  color: rgba(228, 235, 250, 0.6);
  font-size: 22rpx;
  line-height: 1.6;
}

.gold-line {
  margin-top: 20rpx;
  color: #f8faff;
  font-size: 26rpx;
  line-height: 1.7;
}

.footer-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.footer-button {
  flex: 1;
}
