 .home-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx;
  border-radius: 40rpx;
  background:
    radial-gradient(circle at top right, rgba(122, 161, 255, 0.28), transparent 34%),
    linear-gradient(180deg, rgba(10, 18, 34, 0.9), rgba(8, 12, 22, 0.86));
}

.hero::after {
  content: '';
  position: absolute;
  inset: auto -10% -18% auto;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(125, 85, 255, 0.35), transparent 68%);
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.hero-title {
  margin-top: 22rpx;
}

.hero-copy {
  max-width: 540rpx;
}

.hero-badge {
  flex-shrink: 0;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #d8e2ff;
  font-size: 22rpx;
}

.hero-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 40rpx;
}

.hero-stat {
  flex: 1;
  padding: 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.05);
}

.hero-note {
  margin-top: 28rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  color: rgba(233, 239, 255, 0.75);
  font-size: 24rpx;
  line-height: 1.7;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20rpx;
  padding: 8rpx 6rpx;
}

.section-title {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.section-tip {
  max-width: 220rpx;
  color: rgba(221, 229, 247, 0.58);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: right;
}

.scene-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.scene-item {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  width: 100%;
  padding: 28rpx;
  border-radius: 32rpx;
  text-align: left;
}

.scene-item--active {
  border-color: rgba(118, 161, 255, 0.42);
  box-shadow: 0 28rpx 90rpx rgba(44, 86, 201, 0.2);
}

.scene-main {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.scene-tag {
  display: inline-flex;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.scene-title {
  margin-top: 18rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #f7f9ff;
}

.scene-desc {
  margin-top: 14rpx;
  color: rgba(231, 237, 250, 0.72);
  font-size: 25rpx;
  line-height: 1.6;
}

.scene-index {
  color: rgba(255, 255, 255, 0.18);
  font-size: 52rpx;
  font-weight: 700;
}

.scene-footer {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  color: rgba(222, 229, 247, 0.54);
  font-size: 22rpx;
}

.launch-box {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 4rpx;
  padding: 32rpx 28rpx;
  border-radius: 32rpx;
}

.launch-title {
  font-size: 30rpx;
  font-weight: 700;
}

.launch-copy {
  margin-top: 14rpx;
  color: rgba(231, 238, 251, 0.72);
  font-size: 24rpx;
  line-height: 1.7;
}

.guide-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: flex-end;
  padding: 28rpx;
  background: rgba(1, 4, 10, 0.68);
}

.guide-dialog {
  width: 100%;
  padding: 34rpx 28rpx;
  border-radius: 36rpx;
}

.guide-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.guide-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 28rpx;
}

.guide-item {
  display: flex;
  gap: 18rpx;
  color: rgba(237, 242, 255, 0.76);
  font-size: 25rpx;
  line-height: 1.7;
}

.guide-index {
  color: #9ebcff;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.guide-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 34rpx;
}

.guide-ghost,
.guide-start {
  width: 100%;
}
