page {
  min-height: 100%;
  background:
    radial-gradient(circle at top, rgba(50, 119, 255, 0.22), transparent 28%),
    linear-gradient(180deg, #08111f 0%, #050b14 48%, #04070d 100%);
  color: #f3f7ff;
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  line-height: 1;
}

button::after {
  border: none;
}

.safe-shell {
  min-height: 100vh;
  padding: 40rpx 28rpx 56rpx;
}

.page-title {
  font-size: 56rpx;
  line-height: 1.05;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.page-subtitle {
  margin-top: 18rpx;
  color: rgba(232, 239, 255, 0.7);
  font-size: 26rpx;
  line-height: 1.6;
}

.glass-panel {
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(8, 16, 30, 0.72);
  box-shadow: 0 28rpx 80rpx rgba(0, 0, 0, 0.25);
  backdrop-filter: blur(28rpx);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #8bb8ff 0%, #4378ff 55%, #7d55ff 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.03);
  color: rgba(244, 247, 255, 0.92);
  font-size: 28rpx;
}

.section-label {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(132, 168, 255, 0.11);
  color: #bed0ff;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.stat-value {
  font-size: 54rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 8rpx;
  color: rgba(228, 235, 250, 0.62);
  font-size: 22rpx;
}
